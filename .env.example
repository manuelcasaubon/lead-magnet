# Copiar a .env.local para desarrollo. En producción se cargan en Vercel → Project → Settings → Environment Variables.
# Nunca commitear valores reales.

# Sitio
# Producción: https://comunicatumarca.com · Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings → API). La URL es pública; la service_role es secreta y solo va en el servidor.
NEXT_PUBLIC_SUPABASE_URL=https://qzfzswascgitycynwlkk.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago: desde el 6/11 MP_ACCESS_TOKEN vive en los secretos de Supabase (Edge Function "pagos").
# Solo hace falta acá si se vuelve a usar Checkout Pro desde la web (/api/checkout).
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Resend: RESEND_API_KEY vive en los secretos de Supabase. La config no secreta de mails está en la tabla settings.
# Estas solo las usa src/lib/email/enviar.ts (checkout propio, hoy sin uso).
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM="Manu Casaubon <manu@info.comunicatumarca.com>"
EMAIL_REPLY_TO=
# test = solo a EMAIL_TEST_RECIPIENTS. live = personas reales (solo con OK de Manu).
EMAIL_MODE=test
EMAIL_TEST_RECIPIENTS=
MANU_NOTIFY_EMAIL=

# Cron (Vercel lo manda como Authorization: Bearer)
CRON_SECRET=

# VSL (vacío = la landing funciona sin video)
NEXT_PUBLIC_VSL_URL=
NEXT_PUBLIC_VSL_POSTER=

# Microsoft Clarity (id público del proyecto; si falta se usa z96epwr8ri)
NEXT_PUBLIC_CLARITY_PROJECT_ID=z96epwr8ri
# Token de la Data Export API de Clarity (secreto, solo servidor). Lo usa el panel (S5) una vez por día.
CLARITY_API_TOKEN=
