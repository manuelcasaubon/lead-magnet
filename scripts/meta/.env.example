# Copiá este archivo a scripts/meta/.env (git lo ignora) y completalo.
# NUNCA subas el token al repo ni lo cargues en Vercel.

# Token del usuario del sistema "CTM CLI" (no el de "Conversions API System User").
META_SYSTEM_USER_TOKEN=

# Cuenta publicitaria por defecto, con o sin el prefijo act_ (ej.: act_63695471).
META_AD_ACCOUNT_ID=

# ID del portafolio comercial "ᴍᴀɴᴜᴄᴀ/ Estudia conmigo!" (Configuración del negocio > Información del negocio).
META_BUSINESS_ID=

# Opcionales
# META_GRAPH_VERSION=v25.0
# Si la app exige "appsecret_proof", poné acá la clave secreta de la app (solo local).
# META_APP_SECRET=
